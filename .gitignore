# Dependencies and caches
node_modules/
__pycache__/
*.pyc

# Build-phase scratch and evidence (local only)
phase0/
evidence/
BUILD-LOG.md

# Generated payloads for private projects.
# The TESTPLATE payloads are committed as a public fixture; payloads for
# any other project are generated locally by the worker and stay local.
payloads/*
!payloads/TESTPLATE-preview.json
!payloads/TESTPLATE-preview-neutral.json
!payloads/TESTPLATE-certified.json
!payloads/TESTPLATE-certified-neutral.json

.DS_Store
